+def _int_env(name: str, default: int) -> int:
+    raw = os.environ.get(name)
+    if raw is None or raw == "":
+        return default
+    try:
+        return max(1, int(raw))
+    except ValueError:
+        return default
+
+
+def _process_name() -> str:
+    try:
+        import multiprocessing as _mp
+        return _mp.current_process().name
+    except Exception:
+        return "unknown"
+
+
+def _sched_cpu_count() -> int:
+    try:
+        return max(1, len(os.sched_getaffinity(0)))
+    except Exception:
+        return max(1, os.cpu_count() or 1)
+
+
+def _default_threads() -> int:
+    if os.environ.get("SAPC2_THREADS"):
+        return _int_env("SAPC2_THREADS", 1)
+    name = _process_name()
+    if name not in ("MainProcess", "unknown"):
+        return _int_env("SAPC2_WORKER_THREADS", 1)
+    return min(_int_env("SAPC2_MAIN_THREADS", 4), _sched_cpu_count())
+
+
+_PROCESS_NAME = _process_name()
+_THREADS = _default_threads()
